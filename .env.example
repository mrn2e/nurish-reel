# ---------------------------------------------------------------------------
# nurish-reel configuration
# Copy to `.env` and fill in real values. The app runs in "dev" mode with
# stubbed providers when keys are absent, so you can start it with no keys.
# ---------------------------------------------------------------------------

# App
APP_ENV=dev                      # dev | prod
LOG_LEVEL=INFO

# CORS — comma-separated frontend origins allowed to call this API in prod.
# In dev (APP_ENV=dev) all origins are allowed and this is ignored.
# Example: CORS_ORIGINS=https://nurish-reel.vercel.app
CORS_ORIGINS=

# Database (SQLite for dev; swap to a Postgres URL for prod)
DATABASE_URL=sqlite:///./data/nurish.sqlite3

# Object storage
# STORAGE_BACKEND=local -> files written under STORAGE_LOCAL_DIR
# STORAGE_BACKEND=s3    -> uses the S3_* settings below (S3 or MinIO)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
S3_BUCKET=
S3_ENDPOINT_URL=                 # e.g. http://localhost:9000 for MinIO
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Transcription + LLM structuring — both use Gemini (one key for both).
# The audio track is transcribed by Gemini and the combined text is structured
# into a recipe by Gemini, so no separate speech-to-text provider is needed.
GEMINI_API_KEY=
# Structuring model (text -> recipe JSON). Use a floating alias — the pinned
# gemini-1.5-* names were retired and gemini-2.5-flash is blocked for new
# accounts, both 404.
GEMINI_MODEL=gemini-flash-latest
# Transcription model (audio -> text). A dedicated ASR model gives better
# transcripts and uses a separate per-model quota. Leave blank to reuse
# GEMINI_MODEL for both calls.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Nutrition — USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup.html)
USDA_API_KEY=

# Auth0 (leave blank in dev to use a stub "dev user")
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
